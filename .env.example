# ── Database (Supabase Postgres) ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fsm?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fsm?schema=public"

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
WEB_ORIGIN="http://localhost:5173"

# ── Redis / queue (Upstash) ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Encryption (for stored Zoho tokens) ──────────────────────────────────────
# 32-byte base64 key — generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# ── Zoho OAuth (per service / region-aware) ──────────────────────────────────
# Accounts domain depends on the data-centre region: .com / .eu / .sa etc.
ZOHO_ACCOUNTS_DOMAIN="https://accounts.zoho.sa"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REDIRECT_URI="http://localhost:3001/integrations/zoho/callback"

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_BASE_URL="http://localhost:3001"
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY=""
