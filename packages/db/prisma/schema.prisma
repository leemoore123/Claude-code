// FSM Platform — data model
// Multi-tenant root: Organization. Every tenant row carries orgId for RLS.
// Zoho IDs are stored inline for fast lookups AND normalized in ZohoSyncMap
// (the authority for bidirectional sync + conflict detection).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  super_admin
  ops_manager
  dispatcher
  engineer
  client_rep
}

enum SiteType {
  data_centre
  vessel
}

enum AssetType {
  chiller
  crac
  fan_wall
  ahu
  pump
  other
}

enum PpmFrequency {
  monthly
  quarterly
  six_month
  one_year
  three_year
  custom
}

enum JobType {
  ppm
  corrective
  install
  survey
}

enum JobStatus {
  scheduled
  dispatched
  en_route
  on_site
  in_progress
  completed
  signed_off
  invoiced
  cancelled
  on_hold
}

enum DispatchStatus {
  assigned
  accepted
  en_route
  on_site
  done
}

enum SubmissionStatus {
  draft
  completed
  pending_signature
  signed
  void
}

enum SignerRole {
  engineer
  client_rep
}

enum SignatureMethod {
  drawn
  zoho_sign
}

enum ZohoService {
  crm
  books
  sign
  inventory
  fsm
}

enum SyncDirection {
  inbound
  outbound
  both
}

enum SyncStatus {
  in_sync
  pending
  conflict
  error
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy & people
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  clients   Client[]
  parts     Part[]
  zohoConnections ZohoConnection[]
}

model User {
  id        String   @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String   @unique
  fullName  String
  role      UserRole @default(engineer)
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engineer       Engineer?
  jobAssignments JobAssignment[]
  submissions    FormSubmission[] @relation("submissionEngineer")
  uploads        Document[]       @relation("documentUploader")

  @@index([orgId])
}

model Engineer {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          String[]
  homeBase        String?
  zohoFsmAgentId  String?
}

// ─────────────────────────────────────────────────────────────────────────────
// Client hierarchy: Client → Contract → Site → Asset
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id              String   @id @default(uuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  billingAddress  String?
  primaryContact  String?
  status          String   @default("active")
  zohoCrmAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contracts Contract[]
  sites     Site[]
  contacts  Contact[]
  jobs      Job[]
  folders   Folder[]

  @@index([orgId])
}

model Contract {
  id                 String   @id @default(uuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  startDate          DateTime?
  endDate            DateTime?
  value              Decimal?  @db.Decimal(14, 2)
  status             String    @default("active")
  slaTerms           String?
  zohoCrmDealId      String?
  zohoBooksCustomerId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sites Site[]
  jobs  Job[]

  @@index([clientId])
}

model Site {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  siteType   SiteType
  name       String
  code       String?
  region     String?
  hullNumber String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assets   Asset[]
  folders  Folder[]
  jobs     Job[]
  contacts Contact[]

  @@index([clientId])
  @@index([contractId])
}

model Asset {
  id            String    @id @default(uuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assetType     AssetType
  tag           String
  manufacturer  String?
  model         String?
  serial        String?
  installDate   DateTime?
  locationInSite String?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ppmRules    PpmFrequencyRule[]
  jobAssets   JobAsset[]
  submissions FormSubmission[]

  @@index([siteId])
}

model Contact {
  id               String  @id @default(uuid())
  clientId         String?
  client           Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId           String?
  site             Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name             String
  title            String?
  function         String?
  email            String?
  phone            String?
  zohoCrmContactId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([clientId])
  @@index([siteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Documents (breadcrumb folder browser)
// ─────────────────────────────────────────────────────────────────────────────

model Folder {
  id        String   @id @default(uuid())
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?  @relation("folderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("folderTree")
  name      String
  createdAt DateTime @default(now())

  documents Document[]

  @@index([siteId])
  @@index([parentId])
}

model Document {
  id                 String   @id @default(uuid())
  folderId           String
  folder             Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name               String
  storagePath        String
  mime               String?
  version            String?  @default("v1")
  uploadedById       String?
  uploadedBy         User?    @relation("documentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  linkedSubmissionId String?  @unique
  linkedSubmission   FormSubmission? @relation(fields: [linkedSubmissionId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())

  @@index([folderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheduling: PPM rules → jobs → assignments
// ─────────────────────────────────────────────────────────────────────────────

model PpmFrequencyRule {
  id                String   @id @default(uuid())
  assetId           String
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  frequency         PpmFrequency
  customIntervalDays Int?
  scopeLabel        String?
  anchorDate        DateTime
  lastCompletedDate DateTime?
  nextDueDate       DateTime?
  formTemplateId    String?
  formTemplate      FormTemplate? @relation(fields: [formTemplateId], references: [id], onDelete: SetNull)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobs Job[]

  @@index([assetId])
  @@index([nextDueDate])
}

model Job {
  id              String   @id @default(uuid())
  orgId           String
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  jobType         JobType
  sourcePpmRuleId String?
  sourcePpmRule   PpmFrequencyRule? @relation(fields: [sourcePpmRuleId], references: [id], onDelete: SetNull)
  dueCycleDate    DateTime?
  status          JobStatus @default(scheduled)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  priority        String?   @default("normal")
  summary         String?
  zohoFsmWorkorderId String?
  zohoBooksInvoiceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobAssets   JobAsset[]
  assignments JobAssignment[]
  submissions FormSubmission[]
  jobParts    JobPart[]

  // Idempotent PPM materialization: one job per (rule, cycle date)
  @@unique([sourcePpmRuleId, dueCycleDate])
  @@index([orgId])
  @@index([siteId])
  @@index([status])
  @@index([scheduledStart])
}

model JobAsset {
  jobId   String
  job     Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([jobId, assetId])
}

model JobAssignment {
  id             String   @id @default(uuid())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  engineerId     String
  engineer       User     @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  roleOnJob      String   @default("lead")
  dispatchStatus DispatchStatus @default(assigned)
  assignedAt     DateTime @default(now())

  @@unique([jobId, engineerId])
  @@index([engineerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Forms engine (data-driven templates)
// ─────────────────────────────────────────────────────────────────────────────

model FormTemplate {
  id            String   @id @default(uuid())
  name          String
  version       Int      @default(1)
  assetType     AssetType?
  jobType       JobType
  ppmScope      PpmFrequency?
  schema        Json
  pdfLayout     Json?
  requiresSignoff Boolean @default(true)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions FormSubmission[]
  ppmRules    PpmFrequencyRule[]

  @@index([assetType, jobType, ppmScope])
}

model FormSubmission {
  id              String   @id @default(uuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  formTemplateId  String
  formTemplate    FormTemplate @relation(fields: [formTemplateId], references: [id])
  templateVersion Int
  schemaSnapshot  Json
  answers         Json     @default("{}")
  status          SubmissionStatus @default(draft)
  engineerId      String?
  engineer        User?    @relation("submissionEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  completedAt     DateTime?
  pdfUrl          String?
  signedPdfUrl    String?
  zohoSignRequestId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  signatures  Signature[]
  attachments FormAttachment[]
  document    Document?

  @@index([jobId])
  @@index([status])
}

model FormAttachment {
  id           String @id @default(uuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         String
  storagePath  String
  caption      String?
  createdAt    DateTime @default(now())

  @@index([submissionId])
}

model Signature {
  id               String   @id @default(uuid())
  submissionId     String
  submission       FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  signerRole       SignerRole
  signerName       String
  signerEmail      String?
  method           SignatureMethod
  imagePath        String?
  zohoSignActionId String?
  signedAt         DateTime?
  createdAt        DateTime @default(now())

  @@index([submissionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Parts / inventory
// ─────────────────────────────────────────────────────────────────────────────

model Part {
  id                  String  @id @default(uuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sku                 String
  name                String
  description         String?
  unitCost            Decimal? @db.Decimal(12, 2)
  zohoInventoryItemId String?
  createdAt           DateTime @default(now())

  jobParts JobPart[]

  @@unique([orgId, sku])
  @@index([orgId])
}

model JobPart {
  id        String  @id @default(uuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partId    String
  part      Part    @relation(fields: [partId], references: [id], onDelete: Restrict)
  qtyUsed   Int     @default(1)
  unitPrice Decimal? @db.Decimal(12, 2)

  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Zoho integration
// ─────────────────────────────────────────────────────────────────────────────

model ZohoConnection {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  service      ZohoService
  accessToken  String   // encrypted at rest
  refreshToken String   // encrypted at rest
  expiresAt    DateTime
  apiDomain    String
  scopes       String?
  connectedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, service])
}

model ZohoSyncMap {
  id               String   @id @default(uuid())
  entityType       String   // client | contract | contact | invoice | part ...
  localId          String
  zohoService      ZohoService
  zohoModule       String
  zohoRecordId     String
  localHash        String?
  localVersion     Int      @default(1)
  remoteModifiedTime DateTime?
  lastSyncedAt     DateTime?
  syncDirection    SyncDirection @default(both)
  syncStatus       SyncStatus    @default(pending)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, localId, zohoService])
  @@unique([zohoService, zohoModule, zohoRecordId])
  @@index([syncStatus])
}

model SyncAudit {
  id          String   @id @default(uuid())
  entity      String
  localId     String?
  zohoId      String?
  direction   SyncDirection
  payloadHash String?
  result      String   // ok | conflict | error
  error       String?
  createdAt   DateTime @default(now())

  @@index([entity, localId])
  @@index([result])
}
